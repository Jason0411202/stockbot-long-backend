{
  "uid": "stockbot-overview",
  "title": "Stockbot 總覽",
  "description": "HTTP API、主機與容器資源、App log 分類檢視與集中式 log 的單頁總覽 (log 儲存為 VictoriaLogs / LogsQL)",
  "timezone": "Asia/Taipei",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log 等級",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "error,warning,info,debug",
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "關鍵字 (regex)",
        "type": "textbox",
        "query": "",
        "options": [],
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "HTTP API", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "請求速率 (依路徑)", "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum by (path) (rate(http_requests_total[5m]))", "legendFormat": "{{path}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "延遲 p50 / p95 / p99", "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "錯誤率 (4xx / 5xx) 與 in-flight", "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m]))", "legendFormat": "4xx/s", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s", "refId": "B" },
        { "expr": "http_requests_in_flight", "legendFormat": "in-flight", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "row", "title": "主機資源", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries", "title": "CPU 使用率", "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "targets": [{ "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "CPU %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "記憶體使用率", "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM %", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "磁碟使用率", "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs|btrfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "網路流量", "id": 14,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "接收", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "送出", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "row", "title": "容器資源", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries", "title": "各容器記憶體 (working set)", "id": 15,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "targets": [{ "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "各容器 CPU", "id": 16,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "targets": [{ "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "type": "row", "title": "App Log (stockbot-app)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "logs", "title": "App log (依上方 level / 關鍵字篩選)", "id": 17,
      "description": "頂部變數即時過濾:level 下拉選等級、search 輸入 regex 關鍵字;無 level 欄位的行 (如 panic) 一律保留顯示",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 25 },
      "targets": [{ "expr": "{service=\"app\"} _msg:~\"${search}\" (level:~\"${level:pipe}\" or level:\"\") | unpack_json", "refId": "A", "maxLines": 1000 }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "timeseries", "title": "Log 量 (依等級)", "id": 20,
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 25 },
      "targets": [{ "expr": "{service=\"app\"} *", "queryType": "hits", "fields": ["level"], "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*error.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*warning.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*info.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "type": "logs", "title": "交易成交 (買入 / 賣出 + 決策理由)", "id": 21,
      "description": "每筆成交的結構化紀錄:stock_id、trigger、regime、股數、價金與理由摘要。此面板固定回看 1 年 (交易頻率低,不受上方時間範圍影響)",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "timeFrom": "1y",
      "hideTimeOverride": false,
      "targets": [{ "expr": "{service=\"app\"} \"成交\" | unpack_json | filter message:~\"買入成交|賣出成交\"", "refId": "A", "maxLines": 1000 }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "開盤決策迴圈 / 狀態還原", "id": 22,
      "description": "開盤時段決策、開盤價就緒狀態、catch-up 回放與 BotState / 持倉還原",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "targets": [{ "expr": "{service=\"app\"} ~\"開盤|catch-up|首次啟動|還原|水位線|注資\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "TWSE 資料回補", "id": 23,
      "description": "初始回補與每日更新:回補月份清單、逐月抓取結果與完成標記",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "targets": [{ "expr": "{service=\"app\"} ~\"回補|每日資料更新|fetchAndInsertMonth|月份已標記完成|MarkComplete\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "錯誤與警告 (app)", "id": 24,
      "description": "warning / error / fatal 等級,以及無 level 欄位的原始輸出 (如 panic stack trace)",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "targets": [{ "expr": "{service=\"app\"} (level:~\"warning|error|fatal\" or level:\"\")", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "HTTP access log", "id": 25,
      "description": "每個 HTTP request 一行:method、path、status、latency_ms、request_id",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 50 },
      "targets": [{ "expr": "{service=\"app\"} \"method\" | unpack_json | filter method:*", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "row", "title": "其他 Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 }
    },
    {
      "type": "logs", "title": "全容器 error / warning", "id": 18,
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "targets": [{ "expr": "{job=\"docker\"} level:~\"error|warning|fatal\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs", "title": "系統 log (systemd journal)", "id": 19,
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "targets": [{ "expr": "{job=\"systemd-journal\"} *", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
